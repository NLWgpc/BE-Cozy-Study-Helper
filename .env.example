# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3-flash-preview

# Fallback Port / Proxy / Base URL (Optional)
# If set, requests encountering high demand (503) will pass to this port/URL
# GEMINI_FALLBACK_PORT=8001
# GEMINI_FALLBACK_URL=http://localhost:8001
# GEMINI_FALLBACK_API_KEY=your_backup_gemini_key_here

# Retry & Backoff Configuration
GEMINI_MAX_RETRIES=3
GEMINI_INITIAL_DELAY=2.0
GEMINI_BACKOFF_FACTOR=2.0
GEMINI_MAX_DELAY=15.0

# Application Secrets
SECRET_KEY=cozy-secret-key-replace-in-production
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
